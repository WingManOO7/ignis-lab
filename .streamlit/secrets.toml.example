# Copy to .streamlit/secrets.toml (git-ignored) or paste into Streamlit Cloud -> App settings -> Secrets.
# For local runs a .env file works too (git-ignored; see .env.example).
# Only needed for the optional "Generate cited answer" button and scripts/build_summaries.py.
# Without any key the app runs in retrieval-only mode.

GEMINI_API_KEY = ""                 # free key from Google AI Studio
GEMINI_MODEL = "gemini-3.5-flash-lite"   # the default; check the exact model name in AI Studio

# GROQ_API_KEY = ""                 # alternative provider
# GROQ_MODEL = "openai/gpt-oss-20b"
