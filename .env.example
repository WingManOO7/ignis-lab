# Copy to .env (git-ignored) for local runs. On Streamlit Cloud put the same names in App settings -> Secrets.
# Only needed for the optional "Generate cited answer" button on the Ask page and scripts/build_summaries.py.
# Without a key the app runs in retrieval-only mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
